[Unit]
Description=espress0's repo - Personal Software Archive
After=network.target

[Service]
Type=simple
User=espress0
Group=espress0
WorkingDirectory=/opt/espress0s-repo/backend
Environment=NODE_ENV=production
EnvironmentFile=/opt/espress0s-repo/.env
ExecStartPre=/usr/bin/node src/db/migrate.js
ExecStart=/usr/bin/node src/index.js
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=espress0-repo

# Security hardening
# NOTE for installations under a home directory (e.g. ~/espress0s_repo):
# ProtectHome=true hides /home, /root and /run/user from the service, so the
# app would never start — the site stays stuck on the "Loading" screen.
# deploy-ubuntu.sh rewrites this to ProtectHome=false automatically for those
# layouts; change it by hand if you install this unit yourself.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/espress0s-repo/data /opt/espress0s-repo/backups /opt/espress0s-repo/backend/data
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

# Resource limits for small Azure VM
MemoryMax=800M
CPUQuota=100%

[Install]
WantedBy=multi-user.target
