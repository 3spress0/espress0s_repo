[Unit]
Description=espress0's repo - git auto-updater (staged build, swap, health-checked restart)
After=network-online.target espress0-repo.service
Wants=network-online.target

[Service]
Type=simple
# Runs as the app user. It stops the unit before swapping files and starts it
# afterwards, so it needs the unit controlled from the outside; one sudoers line
# grants that (see SETUP.md): stop, restart and start on espress0-repo.
User=espress0
Group=espress0
WorkingDirectory=/opt/espress0s-repo
ExecStart=/opt/espress0s-repo/scripts/auto-update.sh --interval 300 --service espress0-repo
Restart=always
RestartSec=30
StandardOutput=journal
StandardError=journal
SyslogIdentifier=espress0-repo-updater

[Install]
WantedBy=multi-user.target
