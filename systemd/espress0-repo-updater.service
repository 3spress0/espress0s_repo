[Unit]
Description=espress0's repo - git auto-updater (staged build, swap, health-verified restart)
After=network-online.target espress0-repo.service
Wants=network-online.target

[Service]
Type=simple
# Runs as the app user. It stops the unit before swapping files and starts it
# afterwards, so it needs the unit controlled from the outside; one narrow
# sudoers line grants exactly that (stop, restart and start on espress0-repo).
# `deploy-ubuntu.sh` installs and validates that rule automatically.
#
# Every path below is a placeholder: deploy-ubuntu.sh regenerates this unit
# from the real installation directory, so a checkout in /home/<user>/... is
# just as supported as /opt. Do not assume /opt/espress0s-repo is where this
# runs.
User=espress0
Group=espress0
WorkingDirectory=/opt/espress0s-repo
# --service is what makes the updater's restart target explicit. Without a
# restart target the updater refuses to deploy at all, rather than swapping
# files under a process that keeps serving the old commit.
ExecStart=/opt/espress0s-repo/scripts/auto-update.sh --interval 300 --service espress0-repo
Restart=always
RestartSec=30
StandardOutput=journal
StandardError=journal
SyslogIdentifier=espress0-repo-updater

# --- resource containment ----------------------------------------------------
# The updater is the heaviest workload on this machine: a git clone, two
# dependency installs and a bundler. Uncapped, on a 1-2 GB VM, that is enough to
# exhaust memory, start swapping and reach the OOM killer - which does not
# politely pick the build, it can take sshd and the app with it. None of the
# updater's rollback machinery helps if the box itself stops answering.
#
# Inside this cgroup a runaway install/build is killed instead: the update fails,
# the updater's own error paths restart the app on the previous commit, and the
# VM stays reachable. MemoryHigh throttles (reclaim pressure) before MemoryMax
# kills, so a merely-large build slows down rather than dying.
#
# deploy-ubuntu.sh rewrites MemoryHigh/MemoryMax/CPUQuota to fit the real VM and
# passes a matching --min-free-mem to the script; the values below are a safe
# floor for a 1 GB box. Override per host with a drop-in:
#   sudo systemctl edit espress0-repo-updater
MemoryAccounting=yes
MemoryHigh=384M
MemoryMax=512M
CPUAccounting=yes
CPUQuota=50%
TasksMax=256
# The app and sshd outrank the updater for CPU and, more importantly, for disk.
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
# A cgroup OOM kill must not take the unit down permanently: the next cycle
# refuses or rolls back cleanly, so let systemd restart it as usual.
OOMPolicy=continue

[Install]
WantedBy=multi-user.target
