{
  "name": "espress0-repo-backend",
  "version": "1.0.0",
  "description": "Backend for espress0's repo - personal archive",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "migrate": "node src/db/migrate.js",
    "seed": "node src/db/seed.js",
    "test": "node --import ./tests/setup.mjs --test tests/*.test.js",
    "lint": "eslint src tests",
    "audit": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "@fastify/compress": "^9.2.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/multipart": "^10.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.3",
    "@fastify/swagger": "^9.8.1",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.2.0",
    "dotenv": "^16.4.5",
    "fastify": "^5.12.1",
    "jsonwebtoken": "^9.0.2",
    "pino-pretty": "^13.1.3",
    "slugify": "^1.6.6",
    "zod": "^3.23.8"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "globals": "^17.12.0"
  }
}
