# espress0's repo - Environment Configuration
# Copy this to .env and fill in real values. Never commit .env

# === Server ===
NODE_ENV=production
PORT=3000
# 0.0.0.0 = reachable from other machines on this network (that's what makes
# the chosen PORT public); 127.0.0.1 = this machine only.
HOST=0.0.0.0
FRONTEND_URL=http://localhost:5173

# === Database ===
DATABASE_PATH=./data/repo.db

# === Security - CRITICAL: Generate strong secrets for production ===
# Generate with: openssl rand -base64 32
JWT_SECRET=change-this-to-a-long-random-string-min-32-chars
JWT_EXPIRES_IN=7d

# Encryption at rest - AES-256-GCM for sensitive fields
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=change-this-to-a-32-byte-base64-key-for-aes-256-gcm-encryption!

# Password pepper - HMAC secret added before bcrypt
# Generate with: openssl rand -hex 32
PASSWORD_PEPPER=change-this-to-a-64-char-hex-pepper-for-password-hashing!

ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@espress0.local
ADMIN_PASSWORD=ChangeMe123!

# Registration
ALLOW_REGISTRATION=true

# Session cookie Secure flag.
#   unset (recommended): on HTTPS the cookie is Secure; a plain-HTTP login
#     from a non-localhost host degrades automatically (browsers refuse to
#     store Secure cookies over http://, which silently breaks logins) and
#     the server logs a warning.
#   true  — always Secure (correct when TLS is terminated before the app).
#   false — never Secure (deliberate plain-HTTP deployments).
# COOKIE_SECURE=true

# Where fetched media previews are cached (defaults to <repo>/data/previews).
# PREVIEW_DIR=/var/lib/espress0/previews

# === CAPTCHA ===
# Types: math (default, 0 deps), svg (image), turnstile (Cloudflare), hcaptcha, disabled
CAPTCHA_TYPE=math
# Cloudflare Turnstile (optional, free)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# hCaptcha (optional)
HCAPTCHA_SITE_KEY=
HCAPTCHA_SECRET_KEY=

# CORS
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# === Storage Providers ===
DEFAULT_STORAGE_PROVIDER=local

# Google Drive
GOOGLE_DRIVE_ENABLED=false
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_API_KEY=

# OneDrive / Microsoft Graph
ONEDRIVE_ENABLED=false
ONEDRIVE_CLIENT_ID=
ONEDRIVE_CLIENT_SECRET=
ONEDRIVE_TENANT_ID=common
ONEDRIVE_REDIRECT_URI=http://localhost:3000/api/auth/onedrive/callback
ONEDRIVE_DRIVE_ID=
ONEDRIVE_FOLDER_ID=

# === AI (Barista: Ask AI + admin drafting) ===
# Which model answers. Everything here can also be set per-key in
# Admin -> Settings -> AI without a restart, and a value saved there wins over
# the one below - except AI_ENABLED=false, which is a hard switch the settings
# page cannot turn back on. The API key cannot be set there at all (see below).
#   auto    gemini when AI_API_KEY exists, the tgpt CLI when it does not (default)
#   gemini  Google's generateContent REST API - needs a key, nothing installed
#   openai  anything speaking POST {AI_BASE_URL}/chat/completions
#   tgpt    the aandrew-me/tgpt CLI (free, no key) - ./espress0 ai installs it
#   none    no model: answers come from repository metadata only
AI_PROVIDER=auto
# Deployment-level kill switch: false turns Ask AI and admin drafting off, and
# the Settings toggle cannot override it.
AI_ENABLED=true
# Model name. Empty = provider default (currently gemini-2.5-flash for gemini).
# Examples: gemini-2.5-pro, gpt-4o-mini, llama3.1:8b, qwen2.5-coder:32b
AI_MODEL=
# The key. AI_API_KEY wins, but GEMINI_API_KEY / GOOGLE_API_KEY are read too
# because that is what Google's own SDKs and a lot of dotfiles already export -
# so an existing box may need no edit here at all.
# Get one at https://aistudio.google.com/apikey. As of Sept 2026 Google rejects
# *unrestricted* legacy API keys, so create the key in AI Studio (it is issued
# as an auth key, bound to a service account) or add a restriction to an old one.
# This value is deliberately NOT stored in the database: site settings are
# plaintext, readable through /api/admin/settings and copied into every backup,
# so the key lives here with JWT_SECRET and ENCRYPTION_KEY and goes no further.
AI_API_KEY=
# Use another endpoint. Applies to AI_PROVIDER=openai (or AI_FORMAT=openai).
#   https://api.groq.com/openai/v1       Groq (e.g. openai/gpt-oss-120b)
#   https://openrouter.ai/api/v1          OpenRouter (many models, one key)
#   http://127.0.0.1:11434/v1             Ollama on this box (no key needed)
#   http://127.0.0.1:1234/v1            LM Studio
#   https://<resource>.openai.azure.com/...  put api-version in the query string
# Guardrails (this setting makes the backend issue a server-side request):
#   - loopback works as-is: http://127.0.0.1:11434/v1 needs no extra flag
#   - a LAN address needs AI_ALLOW_PRIVATE_BASE_URL=true (see below)
#   - link-local and cloud-metadata addresses (169.254.x.x, fd00:ec2::254,
#     metadata.google.internal, ...) are refused whatever you set
#   - redirects are never followed, so an allowed URL cannot bounce the key
#     somewhere that is not allowed
AI_BASE_URL=
# Wire format override: gemini | openai. Leave empty to derive it from
# AI_PROVIDER; set it only for a proxy that speaks the other shape.
AI_FORMAT=
# Generation knobs, if the defaults are not what you want.
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=2048
# Per-call budgets in milliseconds. Both must stay BELOW the browser's AI
# request budget (AI_TIMEOUT in frontend/src/lib/api.js, 60000) so a slow or
# dead provider still leaves time to send the metadata fallback answer.
# backend/tests/ai.test.js asserts that ordering. AI_TIMEOUT_MS supersedes the
# older TGPT_TIMEOUT_MS, which is still read for existing .env files.
AI_TIMEOUT_MS=20000
AI_DRAFT_TIMEOUT_MS=30000
# Set true to allow an AI_BASE_URL on a non-loopback private address - only
# needed for an inference server on another host on the LAN. Loopback is always
# allowed; metadata addresses are always refused.
AI_ALLOW_PRIVATE_BASE_URL=false

# --- tgpt only: ignored by the gemini/openai backends -----------------------
# Install the binary with: ./espress0 ai   (or: apt/brew install tgpt)
TGPT_ENABLED=true
# Preferred binary location; falls back to a 'tgpt' found on PATH (so
# ~/go/bin/tgpt, ~/.local/bin/tgpt etc. all work).
TGPT_BINARY_PATH=/usr/local/bin/tgpt
# tgpt's own provider: EMPTY uses its built-in default (free, no key).
# openai/deepseek/groq/gemini/mistral/anthropic need TGPT_API_KEY.
TGPT_PROVIDER=
TGPT_MODEL=
TGPT_API_KEY=

# === Rate Limiting ===
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=900000

# === Logging ===
LOG_LEVEL=info

# === Backup - Encrypted backups ===
BACKUP_ENABLED=true
BACKUP_DIR=./backups
BACKUP_CRON=0 2 * * *
BACKUP_ENCRYPT=true

# Catalogue imports take an online database snapshot into BACKUP_DIR before
# applying, and refuse to run if it fails. Set to false to skip snapshots
# (not recommended).
CATALOG_BACKUP=true

# === License / Legal ===
DEFAULT_LICENSE_STATUS=public-domain

# Optional: raises the GitHub API rate limit for scheduled "github-releases" import jobs
# GITHUB_TOKEN=

# Optional: absolute origin used in RSS/Atom feed links (defaults to the request host)
# PUBLIC_URL=https://repo.example.com
