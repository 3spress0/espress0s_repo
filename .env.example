# espress0's repo - Environment Configuration
# Copy this to .env and fill in real values. Never commit .env

# === Server ===
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
FRONTEND_URL=http://localhost:5173

# === Database ===
DATABASE_PATH=./data/repo.db

# === Security - CRITICAL: Generate strong secrets for production ===
# Generate with: openssl rand -base64 32
JWT_SECRET=change-this-to-a-long-random-string-min-32-chars
JWT_EXPIRES_IN=7d

# Encryption at rest - AES-256-GCM for sensitive fields
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=change-this-to-a-32-byte-base64-key-for-aes-256-gcm-encryption!

# Password pepper - HMAC secret added before bcrypt
# Generate with: openssl rand -hex 32
PASSWORD_PEPPER=change-this-to-a-64-char-hex-pepper-for-password-hashing!

ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@espress0.local
ADMIN_PASSWORD=ChangeMe123!

# Registration
ALLOW_REGISTRATION=true

# === CAPTCHA ===
# Types: math (default, 0 deps), svg (image), turnstile (Cloudflare), hcaptcha, disabled
CAPTCHA_TYPE=math
# Cloudflare Turnstile (optional, free)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# hCaptcha (optional)
HCAPTCHA_SITE_KEY=
HCAPTCHA_SECRET_KEY=

# CORS
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# === Storage Providers ===
DEFAULT_STORAGE_PROVIDER=local

# Google Drive
GOOGLE_DRIVE_ENABLED=false
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_API_KEY=

# OneDrive / Microsoft Graph
ONEDRIVE_ENABLED=false
ONEDRIVE_CLIENT_ID=
ONEDRIVE_CLIENT_SECRET=
ONEDRIVE_TENANT_ID=common
ONEDRIVE_REDIRECT_URI=http://localhost:3000/api/auth/onedrive/callback
ONEDRIVE_DRIVE_ID=
ONEDRIVE_FOLDER_ID=

# === AI / tgpt Integration ===
TGPT_ENABLED=true
TGPT_BINARY_PATH=/usr/local/bin/tgpt
TGPT_PROVIDER=openai
TGPT_MODEL=gpt-3.5-turbo
OPENAI_API_KEY=

# === Rate Limiting ===
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=900000

# === Logging ===
LOG_LEVEL=info

# === Backup - Encrypted backups ===
BACKUP_ENABLED=true
BACKUP_DIR=./backups
BACKUP_CRON=0 2 * * *
BACKUP_ENCRYPT=true

# === License / Legal ===
DEFAULT_LICENSE_STATUS=public-domain
