# Nginx config for espress0's repo
# Place at /etc/nginx/sites-available/espress0 and symlink to sites-enabled

upstream espress0_backend {
    server 127.0.0.1:3000;
    keepalive 32;
}

server {
    listen 80;
    server_name espress0.example.com www.espress0.example.com;

    # Redirect to HTTPS (after certbot)
    # return 301 https://$host$request_uri;

    # For initial setup without HTTPS, proxy directly
    location / {
        proxy_pass http://espress0_backend;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Don't proxy large file downloads through nginx buffer - stream directly
        proxy_buffering off;
        proxy_request_buffering off;

        # Timeouts
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }

    # Security: block sensitive files
    location ~ /\. {
        deny all;
        access_log off;
        log_not_found off;
    }

    location ~ ^/(data|backups|node_modules)/ {
        deny all;
        return 404;
    }

    # Gzip
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_types
        text/plain
        text/css
        text/xml
        text/javascript
        application/json
        application/javascript
        application/xml+rss
        application/rss+xml
        font/truetype
        font/opentype
        application/vnd.ms-fontobject
        image/svg+xml;

    # Logging
    access_log /var/log/nginx/espress0_access.log;
    error_log /var/log/nginx/espress0_error.log;
}

